{
  "如果条件": {
    "prefix": "如果",
    "body": [
      "如果 ${1:条件} 那么",
      "    $0",
      "结束"
    ],
    "description": "如果…那么…结束 条件语句"
  },
  "否则": {
    "prefix": "否则",
    "body": [
      "否则",
      "    $0"
    ],
    "description": "否则 分支"
  },
  "否则如果": {
    "prefix": "否则如果",
    "body": [
      "否则如果 ${1:条件} 那么",
      "    $0"
    ],
    "description": "否则如果…那么 分支"
  },
  "判断": {
    "prefix": "判断",
    "body": [
      "判断 ${1:表达式}",
      "    为 ${2:值}",
      "        $0",
      "    其他",
      "        ",
      "结束"
    ],
    "description": "判断多分支选择"
  },
  "当循环": {
    "prefix": "当",
    "body": [
      "当 ${1:条件} 循环",
      "    $0",
      "结束"
    ],
    "description": "当…循环 条件循环"
  },
  "遍历": {
    "prefix": "遍历",
    "body": [
      "遍历 ${1:容器} 中的 ${2:元素}",
      "    $0",
      "结束"
    ],
    "description": "遍历…中的 for-in 循环"
  },
  "重复次数": {
    "prefix": "重复",
    "body": [
      "重复 ${1:次数} 次",
      "    $0",
      "结束"
    ],
    "description": "重复 n 次循环"
  },
  "无限循环": {
    "prefix": "循环",
    "body": [
      "循环",
      "    $0",
      "结束"
    ],
    "description": "无限循环（配合 跳出 使用）"
  },
  "定义函数": {
    "prefix": "函数",
    "body": [
      "函数 ${1:函数名}(${2:参数})${3: -> ${4:返回类型}}",
      "    $0",
      "结束"
    ],
    "description": "定义函数"
  },
  "匿名函数": {
    "prefix": "函数()",
    "body": [
      "函数()",
      "    $0",
      "结束"
    ],
    "description": "无参匿名函数"
  },
  "分段函数": {
    "prefix": "分段函数",
    "body": [
      "函数 ${1:动作}(${2:参数} ${3:类型})${4:连接词}${5:段名}(${6:参数} ${7:类型}) -> ${8:返回类型}",
      "    $0",
      "结束"
    ],
    "description": "定义分段（mixfix）函数"
  },
  "定义模型": {
    "prefix": "模型",
    "body": [
      "模型 ${1:模型名}",
      "    $0",
      "结束"
    ],
    "description": "定义模型"
  },
  "定义类": {
    "prefix": "类",
    "body": [
      "类 ${1:类名}",
      "    $0",
      "结束"
    ],
    "description": "定义类（模型的别名）"
  },
  "模型字段": {
    "prefix": "变量",
    "body": [
      "变量 ${1:类型} ${2:字段名}"
    ],
    "description": "声明带类型的变量/模型字段"
  },
  "常量": {
    "prefix": "常量",
    "body": [
      "常量 ${1:类型} ${2:名字} = ${3:值}"
    ],
    "description": "声明常量"
  },
  "模型方法": {
    "prefix": "方法",
    "body": [
      "定义 ${1:模型名} 的 方法 ${2:方法名}(${3:参数})${4: -> ${5:返回类型}}",
      "    $0",
      "结束"
    ],
    "description": "在模型外部定义方法，方法体内可用 自己 访问当前实例"
  },
  "稍后": {
    "prefix": "稍后",
    "body": [
      "稍后 ${1:调用()}"
    ],
    "description": "稍后（defer）：函数退出时执行"
  },
  "稍后恢复": {
    "prefix": "稍后函数",
    "body": [
      "稍后 函数()",
      "    变量 ${1:异常} = 捕获()",
      "    $0",
      "结束"
    ],
    "description": "稍后匿名函数，用 捕获() 恢复抛出"
  },
  "抛出": {
    "prefix": "抛出",
    "body": [
      "抛出 ${1:值}"
    ],
    "description": "抛出任意值（panic），可用稍后中的捕获()恢复"
  },
  "捕获": {
    "prefix": "捕获",
    "body": "捕获()",
    "description": "在稍后注册的函数中恢复当前抛出的值"
  },
  "检查调用": {
    "prefix": "检查",
    "body": "检查 ${1:可能返回错误的调用}",
    "description": "检查：自动向上传播普通错误值"
  },
  "错误值": {
    "prefix": "错误",
    "body": "错误(\"$0\")",
    "description": "构造错误值"
  },
  "导入模块": {
    "prefix": "导入",
    "body": "导入 \"${1:模块路径}\"${2: 作为 ${3:别名}}",
    "description": "导入模块"
  },
  "公开": {
    "prefix": "公开",
    "body": "公开 ${1:变量|常量|函数|模型} ${2:名字}",
    "description": "声明公开成员（可跨模块访问）"
  },
  "私有": {
    "prefix": "私有",
    "body": "私有 ${1:变量|常量|函数|模型} ${2:名字}",
    "description": "声明私有成员（模型私有成员仅限本模型方法访问）"
  },
  "打印": {
    "prefix": "打印",
    "body": "打印($0)",
    "description": "打印输出"
  },
  "返回": {
    "prefix": "返回",
    "body": "返回 $0",
    "description": "从函数返回"
  }
}
