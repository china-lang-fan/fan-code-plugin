{
  "name": "fan-lang",
  "displayName": "凡语言支持",
  "description": "凡语言（fan）的语法高亮、代码片段、注释切换与脚本运行支持",
  "version": "0.5.0",
  "publisher": "china-lang-fan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/china-lang-fan/fan-code-plugin.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "fan",
    "凡语言",
    "中文编程语言",
    "chinese programming language"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:fan"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fan",
        "aliases": [
          "凡语言",
          "fan",
          "Fan"
        ],
        "extensions": [
          ".凡",
          ".fan"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fan",
        "scopeName": "source.fan",
        "path": "./syntaxes/fan.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fan",
        "path": "./snippets/snippets.json"
      }
    ],
    "commands": [
      {
        "command": "fan.run",
        "title": "fan: 运行当前脚本",
        "icon": "$(play)"
      },
      {
        "command": "fan.repl",
        "title": "fan: 启动交互式 REPL"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "fan.run",
          "when": "resourceLangId == fan",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "fan",
      "properties": {
        "fan.executablePath": {
          "type": "string",
          "default": "fan",
          "description": "fan 解释器可执行文件的路径，默认从 PATH 中查找。"
        },
        "fan.runInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "是否在集成终端中运行脚本。"
        },
        "fan.clearBeforeRun": {
          "type": "boolean",
          "default": false,
          "description": "运行前是否先清空终端。"
        },
        "fan.languageServer.enable": {
          "type": "boolean",
          "default": true,
          "description": "是否启用凡语言服务器（LSP），提供语法错误与分段函数空格等实时诊断。"
        },
        "fan.pinyinCompletion.enable": {
          "type": "boolean",
          "default": true,
          "description": "是否启用拼音补全：输入全拼、首字母或双拼即可补全中文关键字与项目符号。"
        },
        "fan.pinyinCompletion.maxSuggest": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "拼音补全候选的最大数量。"
        },
        "fan.pinyinCompletion.schemes": {
          "type": "object",
          "default": { "full": true, "initial": true, "double": true },
          "description": "启用的输入模式：full=全拼，initial=首字母，double=双拼。",
          "properties": {
            "full": { "type": "boolean" },
            "initial": { "type": "boolean" },
            "double": { "type": "boolean" }
          }
        },
        "fan.pinyinCompletion.doublePinyinScheme": {
          "type": "string",
          "default": "ziranma",
          "enum": ["ziranma", "xiaohe"],
          "enumDescriptions": ["自然码双拼", "小鹤双拼"],
          "description": "双拼键位方案。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
